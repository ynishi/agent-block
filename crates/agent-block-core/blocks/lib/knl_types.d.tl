--- knl_types — the kernel's syscall types, for the checker.
---
--- Generated by agent-block-core from the argument and return types of
--- `bridge/knl.rs` (schema-bridge -> Teal), the same types `knl_types`
--- (the lshape module) declares for run time. Not hand-written: a test
--- holds this file to the generator, and the host hands the checker its
--- own render at start, so there is nothing here to edit.
local record knl_types
    type SessionId = string
    type ScopeId = string
    type Owner = string
    type BeatId = string
    type Seq = integer
    type Count = integer
    type Amount = integer
    type Remaining = integer | nil
    type Exhausted = boolean
    type Sql = string
    type CloseReason = string
    type CloseDetail = string
    type Raised = any
    enum ViewName
        "tail"
    end
    record ViewOpts
        n: integer
    end
    record OpenOpts
        owner: string
        budget: any
        store: any
        meta: {string:string | number | boolean}
        parent: any
    end
    record ResumeOpts
        store: any
        session: string
        budget: any
    end
    record AppendEvent
        kind: string
        meta: {string:string | number | boolean}
        data: any
    end
    type EventsResult = {{any}, boolean}
    type QueryParams = any
    record QueryOpts
        sessions: {string}
        timeout_ms: integer
        limit: integer
    end
    type QueryResult = {{any}, boolean}
    record ErrorTable
        kind: string
        method: string
        retryable: boolean
        message: string
    end
    record ApiReport
        record SessionEntry
            name: string
            doc: string
        end
        session: {SessionEntry}
        record ModuleEntry
            name: string
            doc: string
        end
        module: {ModuleEntry}
        errors: {string}
        record Schema
            table: string
            record ColumnsEntry
                name: string
                ["type"]: string
                pk: boolean
            end
            columns: {ColumnsEntry}
        end
        schema: Schema
        record Fields
            amount: string
            tag: string
            desc: string
            remaining: string
            scope_id: string
            owner: string
            parent: string
            child: string
            reason: string
            detail: string
            open_children: string
        end
        fields: Fields
        types: string
    end
end
return knl_types
