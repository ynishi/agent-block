-- Generated by htl shapes: the declaration of lshape that the generated shapes are written against. Do not edit; `htl shapes` rewrites it.
-- lshape: 0.3
-- It declares lshape 0.3's public surface: `lshape.t`, `lshape.check`, `lshape.reflect` and
-- `lshape.luacats`, so a project that writes some shapes by hand next to the generated ones
-- needs no second declaration of lshape.
-- The type argument of a `Schema<T>` is what a value that passed it is: the generated
-- `types/shapes/<module>.d.tl` says `Schema<main.Request>` for the shape of `main.Request`,
-- and `assert` hands that type back, so one call replaces the cast of every read after it.
local record lshape
   -- What a container of shapes takes: `T.shape`, `T.partial`, `T.tuple`, `T.any_of`,
   -- `T.discriminated`, `CheckOpts.registry`, `check.default_registry` and `luacats.gen` hold
   -- shapes of different type arguments side by side, `T.array_of` and `T.map_of` take one
   -- as an overload, and `reflect` hands them out. Teal's
   -- generics are invariant, so a `Schema<string>` is not a `Schema<any>` and
   -- `{string : Schema<any>}` would refuse `{ name = T.string }`; `AnySchema` has no type
   -- argument, and every `Schema<T>` is one.
   -- It carries the modifiers, so a holder of an `AnySchema` can chain them. They return
   -- `AnySchema` and not `self`: Teal does not resolve the `self` a call returns, so a second
   -- modifier after the first had nothing to index.
   interface AnySchema
      is_optional: function(self): AnySchema
      describe: function(self, doc: string): AnySchema
      min: function(self, n: number): AnySchema
      max: function(self, n: number): AnySchema
      min_len: function(self, n: integer): AnySchema
      max_len: function(self, n: integer): AnySchema
   end

   -- A shape. The modifiers are redeclared here to return `Schema<T>`: `AnySchema`'s return
   -- `AnySchema` has no type argument, and a chain through it would hand `assert` an
   -- unresolved `T` that accepts any read. `:is_optional()` is how a generated record says
   -- a field may be nil, and is read by the record, not here.
   record Schema<T> is AnySchema
      is_optional: function(self: Schema<T>): Schema<T>
      describe: function(self: Schema<T>, doc: string): Schema<T>
      min: function(self: Schema<T>, n: number): Schema<T>
      max: function(self: Schema<T>, n: number): Schema<T>
      min_len: function(self: Schema<T>, n: integer): Schema<T>
      max_len: function(self: Schema<T>, n: integer): Schema<T>
   end

   record ShapeOpts
      open: boolean
   end

   -- `lshape.t`: what a generated shape file calls.
   record Combinators
      string: Schema<string>
      number: Schema<number>
      integer: Schema<integer>
      boolean: Schema<boolean>
      table: Schema<{any : any}>
      fn: Schema<function>
      any: Schema<any>
      shape: function<T>({string : AnySchema}, ?ShapeOpts): Schema<T>
      -- `array_of` and `map_of` take a `Schema<E>` and hand back the container of `E`; given an
      -- `AnySchema` (one `reflect` hands out, or a variable typed so) the element is `any`.
      -- The generic overload comes first, so a `Schema<E>` keeps its `E`.
      array_of: function<E>(Schema<E>): Schema<{E}>
      array_of: function(AnySchema): Schema<{any}>
      map_of: function<K, V>(Schema<K>, Schema<V>): Schema<{K : V}>
      map_of: function(AnySchema, AnySchema): Schema<{any : any}>
      tuple: function<T>({AnySchema}): Schema<T>
      one_of: function<E>({E}): Schema<E>
      literal: function<T>(T): Schema<T>
      any_of: function<T>({AnySchema}): Schema<T>
      -- `shape` with every field made optional.
      partial: function<T>({string : AnySchema}, ?ShapeOpts): Schema<T>
      -- A tagged union: `variants` maps a tag value to the shape of that variant. Each
      -- variant must be a shape that declares the `tag` field; lshape raises at construction
      -- when one does not, and the types cannot say so.
      discriminated: function<T>(string, {string : AnySchema}): Schema<T>
      -- A string that matches a Lua pattern.
      pattern: function(string): Schema<string>
      -- The shape registered under a name, looked up in `CheckOpts.registry` or
      -- `check.default_registry` when a value is checked.
      ref: function<T>(string): Schema<T>
   end

   -- The last argument of `check`, `assert` and `assert_dev`: where a `T.ref`, or a name given
   -- to `assert`, is looked up. When it is left out the lookup uses `check.default_registry`.
   record CheckOpts
      registry: {string : AnySchema}
   end

   -- `lshape.check`: the validator.
   record Checker
      -- `true`, or `false` and the reason, with the path of the field that failed.
      -- It takes any `AnySchema`, so a schema `reflect` hands out can be checked.
      check: function(any, AnySchema, ?CheckOpts): boolean, string
      -- The value when it passes; raises, naming the reason and the hint, when not. Given a
      -- `Schema<T>` it is typed `T`; given a registry name, or an `AnySchema` such as
      -- `reflect` hands out, it is `any`, since neither says what the shape is. `"any"`
      -- passes everything.
      assert: function<T>(any, Schema<T>, ?string, ?CheckOpts): T
      assert: function(any, string, ?string, ?CheckOpts): any
      assert: function(any, AnySchema, ?string, ?CheckOpts): any
      -- `assert` when dev mode is on, and the value as it is when it is off.
      assert_dev: function<T>(any, Schema<T>, ?string, ?CheckOpts): T
      assert_dev: function(any, string, ?string, ?CheckOpts): any
      assert_dev: function(any, AnySchema, ?string, ?CheckOpts): any
      -- Whether the environment variable named by `dev_env_var` is `"1"`.
      is_dev_mode: function(): boolean
      -- The environment variable `is_dev_mode` reads; `"LSHAPE_CHECK"` until a host sets it.
      dev_env_var: string
      -- Where a name is looked up when no `CheckOpts.registry` is passed. A field the host
      -- assigns: it is nil when lshape loads, and a lookup that needs it raises until it is set.
      default_registry: {string : AnySchema}
   end

   -- One field of a shape, as `reflect.fields` reports it. `type` is the field's schema with
   -- `:is_optional()` and `:describe()` taken off; they are `optional` and `doc`.
   record Field
      name: string
      type: AnySchema
      optional: boolean
      -- Set when the field was described; nil otherwise.
      doc: string
   end

   -- `lshape.reflect`: read-only reflection over shapes.
   record Reflect
      -- The direct fields of a shape, sorted by name; raises for a schema that is not a shape.
      fields: function(AnySchema): {Field}
      -- Calls the visitor with the schema and then with every schema nested in it, depth first.
      walk: function(AnySchema, function(AnySchema))
   end

   -- `lshape.luacats`: LuaCATS `---@class` codegen.
   record Luacats
      -- The text of a `.d.lua` file for the shapes of a table keyed by name; the second
      -- argument prefixes every class name.
      gen: function(?{string : AnySchema}, ?string): string
      -- One `---@class` block, for a shape; the third argument is the prefix `T.ref` names take.
      class_for: function(string, AnySchema, ?string): string
   end

   t: Combinators
   check: Checker
   reflect: Reflect
   luacats: Luacats
end

return lshape
